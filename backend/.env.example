# O Urban Copilot roda offline com heurística quando estas variáveis não existem.
# Preencha para usar um LLM compatível com a API da OpenAI.
URBAN_COPILOT_API_KEY=
URBAN_COPILOT_BASE_URL=
URBAN_COPILOT_MODEL=

# Origens liberadas no CORS (separadas por vírgula).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
